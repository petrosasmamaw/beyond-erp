{
  "entities": {
    "User": {
      "title": "User",
      "description": "Enterprise user profile and permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "companyName": { "type": "string" }
      },
      "required": ["id", "fullName", "email", "role"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction ledger record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "sectorId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "amount", "description"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles collection"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Transactions collection"
    }
  }
}
